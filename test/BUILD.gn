import("//build/ohos.gni")

group("moduletest") {
  testonly = true
  deps = []

  deps += [ "moduletest/common:moduletest" ]
}

declare_args() {
  hiviewdfx_hitrace_enabled_for_static_test = false
  if (defined(global_parts_info) &&
      defined(global_parts_info.hiviewdfx_hitrace)) {
    hiviewdfx_hitrace_enabled_for_static_test = true
  }
}

config("hisysevent_test_config") {
  visibility = [ "*:*" ]

  include_dirs = [ "//base/hiviewdfx/hisysevent/interfaces/native/innerkits/hisysevent/include" ]
}

ohos_static_library("hisysevent_static_lib_for_tdd") {
  configs = [ ":hisysevent_test_config" ]

  public_configs = [ ":hisysevent_test_config" ]

  sources = [
    "../interfaces/native/innerkits/hisysevent/encoded_param.cpp",
    "../interfaces/native/innerkits/hisysevent/event_socket_factory.cpp",
    "../interfaces/native/innerkits/hisysevent/hisysevent.cpp",
    "../interfaces/native/innerkits/hisysevent/hisysevent_c.cpp",
    "../interfaces/native/innerkits/hisysevent/raw_data.cpp",
    "../interfaces/native/innerkits/hisysevent/raw_data_base_def.cpp",
    "../interfaces/native/innerkits/hisysevent/raw_data_encoder.cpp",
    "../interfaces/native/innerkits/hisysevent/stringfilter.cpp",
    "../interfaces/native/innerkits/hisysevent/transport.cpp",
    "../interfaces/native/innerkits/hisysevent/write_controller.cpp",
  ]

  output_name = "hisysevent_static_lib_for_tdd"

  part_name = "hisysevent"

  subsystem_name = "hiviewdfx"

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "hilog:libhilog",
  ]

  defines = []
  if (hiviewdfx_hitrace_enabled_for_static_test) {
    external_deps += [ "hitrace:libhitracechain" ]
    defines += [ "HIVIEWDFX_HITRACE_ENABLED" ]
  }
}

config("hisyseventmanager_test_config") {
  visibility = [ "*:*" ]

  include_dirs = [
    "//base/hiviewdfx/hisysevent/interfaces/native/innerkits/hisysevent_manager/include",
    "//base/hiviewdfx/hisysevent/interfaces/native/innerkits/hisysevent/include",
    "//base/hiviewdfx/hisysevent/interfaces/native/innerkits/hisysevent/encode/include",
    "include",
  ]
}

ohos_static_library("hisyseventmanager_static_lib_for_tdd") {
  sources = [
    "../interfaces/native/innerkits/hisysevent_manager/hisysevent_base_manager.cpp",
    "../interfaces/native/innerkits/hisysevent_manager/hisysevent_listener_c.cpp",
    "../interfaces/native/innerkits/hisysevent_manager/hisysevent_manager.cpp",
    "../interfaces/native/innerkits/hisysevent_manager/hisysevent_manager_c.cpp",
    "../interfaces/native/innerkits/hisysevent_manager/hisysevent_query_callback_c.cpp",
    "../interfaces/native/innerkits/hisysevent_manager/hisysevent_record.cpp",
    "../interfaces/native/innerkits/hisysevent_manager/hisysevent_record_c.cpp",
    "../interfaces/native/innerkits/hisysevent_manager/hisysevent_record_convertor.cpp",
  ]

  output_name = "hisyseventmanager_static_lib_for_tdd"

  part_name = "hisysevent"

  subsystem_name = "hiviewdfx"

  public_configs = [
    "//base/hiviewdfx/hisysevent/adapter/native/idl:sys_event_impl_config",
    ":hisyseventmanager_test_config",
  ]

  deps = [
    "../adapter/native/idl:sys_event_impl_client",
    "../frameworks/native/util:hisysevent_util",
    ":hisysevent_static_lib_for_tdd",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "jsoncpp:jsoncpp",
    "samgr:samgr_proxy",
  ]
}

group("unittest") {
  testonly = true
  deps = []
  if (support_jsapi) {
    deps += [
      "unittest/common/napi:HiSysEventJsTest",
      "unittest/common/permission:HiSysEventPermissionJsTest",
      "//base/hiviewdfx/hisysevent/frameworks/native:unittest",
    ]
  }
  if (!use_clang_coverage) {
    deps += [ "unittest/rust:rust_hisysevent_test" ]
  }
}

group("fuzztest") {
  testonly = true
  deps = [
    "fuzztest/common/hisysevent_fuzzer:HiSysEventFuzzTest",
    "fuzztest/common/hisyseventmanager_fuzzer:HiSysEventManagerFuzzTest",
  ]
}
